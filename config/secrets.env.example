# Copy this file to config/secrets.env (it is git-ignored) and fill in what you use.
#   cp config/secrets.env.example config/secrets.env
# The names on the left are the ones you write as "token_env" in config.json; the values never go in
# config.json. docker compose passes this file to the container as environment variables. Nothing
# here is required: leave out what you do not use.

# Private repos declared by clone URL (git_credentials in config.json). GitHub: a fine-grained token
# with read access to "Contents". GitLab: a token with read_repository (and "username": "oauth2").
#GITHUB_TOKEN=github_pat_...
#GITLAB_TOKEN=glpat-...

# Issue mirrors (issue_mirrors in config.json): READ-ONLY tokens, the server never writes to the forge.
# GitHub: fine-grained token, "Issues: Read" on the listed repositories. GitLab: read_api.
#GITHUB_ISSUES_TOKEN=github_pat_...
#GITLAB_ISSUES_TOKEN=glpat-...
